<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar producto"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nombre del producto"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="14dp"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"/>

        <Spinner
            android:id="@+id/spMarca"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:drawable/edit_text"
            android:padding="14dp"
            android:layout_marginBottom="14dp"/>

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:drawable/edit_text"
            android:padding="14dp"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etPresentacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Presentación (ej. 625 ml)"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="14dp"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etCantidad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Cantidad inicial"
            android:inputType="number"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="14dp"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Código del producto"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnEscanearCodigo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Escanear código QR"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginBottom="14dp"/>

        <EditText
            android:id="@+id/etImagenUrl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="URL de imagen (opcional)"
            android:inputType="textUri"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"/>

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar producto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            />

    </LinearLayout>

</ScrollView>