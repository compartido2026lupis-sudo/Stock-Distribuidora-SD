<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar movimiento"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvProductoMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Producto"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvPresentacionMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presentación:"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvExistenciaMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Existencia actual:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de movimiento"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rgTipoMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbEntrada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrada"
                android:textColor="#16A34A"
                android:layout_marginEnd="24dp"/>

            <RadioButton
                android:id="@+id/rbSalida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salida"
                android:textColor="#DC2626"/>

        </RadioGroup>

        <EditText
            android:id="@+id/etCantidadMovimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Cantidad"
            android:inputType="number"
            android:textColor="#243B6B"
            android:textColorHint="#64748B"
            android:background="@android:drawable/edit_text"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnConfirmarMovimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar movimiento"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"/>

    </LinearLayout>

</ScrollView>