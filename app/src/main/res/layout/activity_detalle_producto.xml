<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información del producto"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/imgProductoDetalle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del producto"/>

        <TextView
            android:id="@+id/tvNombreDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Producto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvMarcaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marca:"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvCategoriaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría:"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvPresentacionDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presentación:"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvExistenciaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Existencia actual:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnRegistrarEntrada"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Registrar entrada"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnRegistrarSalida"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="- Registrar salida"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"/>

        <Button
            android:id="@+id/btnEditarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Editar producto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnEliminarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Eliminar producto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"/>

    </LinearLayout>

</ScrollView>