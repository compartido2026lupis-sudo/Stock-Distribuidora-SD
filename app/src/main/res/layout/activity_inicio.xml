<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7F7">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock Distribuidora SD"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Hola!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#243B6B"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué deseas hacer hoy?"
            android:textSize="16sp"
            android:textColor="#64748B"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnEscanearQR"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Escanear QR"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnInventario"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Inventario"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnRegistrarProducto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Registrar producto"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Historial de movimientos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5" />

        <Button
            android:id="@+id/btnCatalogos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Administrar catálogos"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginTop="14dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>